# Baked into the Expo bundle at build time (EXPO_PUBLIC_ vars are not secret).
#
# For local dev against a backend on your machine:
#   - Web / iOS simulator:  http://localhost:3000/api
#   - Android emulator:     http://10.0.2.2:3000/api
#   - Physical device:      http://<your-LAN-IP>:3000/api
# Put local overrides in .env.local (gitignored) instead of editing this file.
#
# For shared testing (Expo Go tunnel), set this to the deployed Render URL so
# testers' phones can reach the API, then commit the change:
EXPO_PUBLIC_API_BASE_URL=https://safety-app-zlri.onrender.com/api
