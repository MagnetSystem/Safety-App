generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Shared login/identity record across all roles.
model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  collegeAdmin       CollegeAdmin?
  uploadedEvidence   ComplaintEvidence[]
  complaintMessages  ComplaintMessage[]
  complaintTimelines ComplaintTimeline[]
  notifications      Notification[]
  student            Student?

  @@index([role])
  @@map("users")
}

/// One record per college. Scopes all student/complaint data.
model College {
  id         String         @id @default(uuid())
  name       String
  code       String         @unique
  address    String?
  state      String?
  district   String?
  principal  String?
  phone      String?
  email      String?
  status     CollegeStatus  @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  auditLogs  AuditLog[]
  admins     CollegeAdmin[]
  complaints Complaint[]
  students   Student[]

  @@index([status])
  @@map("colleges")
}

/// Full student profile: personal, academic, contact, emergency info.
model Student {
  id                    String      @id @default(uuid())
  userId                String      @unique
  collegeId             String
  name                  String
  photoUrl              String?
  studentNumber         String?
  dateOfBirth           DateTime?
  gender                String?
  department            String?
  course                String?
  semester              String?
  year                  Int?
  section               String?
  isHosteler            Boolean?    @default(false)
  mobile                String?
  guardianName          String?
  guardianPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  permanentAddress      String?
  hostelAddress         String?
  hostelRoomNumber      String?
  bloodGroup            String?
  medicalConditions     String?
  allergies             String?
  disability            String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  complaints            Complaint[]
  college               College     @relation(fields: [collegeId], references: [id])
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([studentNumber])
  @@map("students")
}

/// Admin accounts, each linked to exactly one college.
model CollegeAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  collegeId String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@map("college_admins")
}

/// The core report record.
model Complaint {
  id                       String              @id @default(uuid())
  code                     String              @unique
  collegeId                String
  studentId                String?
  type                     ReportType
  category                 IncidentCategory
  status                   ComplaintStatus     @default(SUBMITTED)
  priority                 ComplaintPriority   @default(NORMAL)
  description              String
  incidentDate             DateTime?
  location                 String?
  suspectedStudents        String?
  witnesses                String?
  gpsLat                   Float?
  gpsLng                   Float?
  gpsAccuracy              Float?
  deviceInfo               String?
  isAnonymous              Boolean             @default(false)
  assignedCommitteeUserIds String[]            @default([])
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  resolutionReport         String?
  evidence                 ComplaintEvidence[]
  messages                 ComplaintMessage[]
  timeline                 ComplaintTimeline[]
  college                  College             @relation(fields: [collegeId], references: [id])
  student                  Student?            @relation(fields: [studentId], references: [id])

  @@index([collegeId, status])
  @@index([collegeId, createdAt])
  @@index([studentId])
  @@map("complaints")
}

/// Uploaded files linked to a specific complaint.
model ComplaintEvidence {
  id           String       @id @default(uuid())
  complaintId  String
  type         EvidenceType
  storagePath  String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime     @default(now())
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])

  @@index([complaintId])
  @@map("complaint_evidence")
}

/// Two-way messages between the reporting student and the committee.
/// Used mainly to resolve MORE_INFO_REQUESTED, and for the student's
/// "I'm safe now" follow-up on an emergency.
model ComplaintMessage {
  id          String    @id @default(uuid())
  complaintId String
  authorId    String?
  authorRole  UserRole
  body        String
  createdAt   DateTime  @default(now())
  author      User?     @relation(fields: [authorId], references: [id])
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_messages")
}

/// Step-by-step history of a complaint's workflow.
model ComplaintTimeline {
  id          String          @id @default(uuid())
  complaintId String
  status      ComplaintStatus
  note        String?
  actorId     String?
  createdAt   DateTime        @default(now())
  actor       User?           @relation(fields: [actorId], references: [id])
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_timeline")
}

/// Queued and sent notifications per user.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// Immutable record of sensitive actions across the platform.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  collegeId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  college    College? @relation(fields: [collegeId], references: [id])

  @@index([collegeId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum UserRole {
  STUDENT
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum CollegeStatus {
  ACTIVE
  SUSPENDED
}

enum ReportType {
  EMERGENCY
  NORMAL
  ANONYMOUS
}

enum IncidentCategory {
  PHYSICAL_RAGGING
  VERBAL_ABUSE
  MENTAL_HARASSMENT
  THREAT
  HOSTEL_RAGGING
  CLASSROOM_RAGGING
  CYBER_BULLYING
  MONEY_EXTORTION
  SEXUAL_HARASSMENT
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATING
  MORE_INFO_REQUESTED
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum EvidenceType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum NotificationType {
  REPORT_SUBMITTED
  INVESTIGATION_STARTED
  MORE_INFO_REQUESTED
  REPORT_CLOSED
  NEW_EMERGENCY_REPORT
  NEW_COMPLAINT
  NEW_EVIDENCE_UPLOADED
  NEW_MESSAGE
  STATUS_CHANGED
  GENERIC
}
