generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Shared login/identity record across all roles.
model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  auditLogs          AuditLog[]
  orgStaff           OrgStaff?
  uploadedEvidence   IncidentEvidence[]
  incidentMessages   IncidentMessage[]
  incidentTimelines  IncidentTimeline[]
  assignedIncidents  Incident[]           @relation("IncidentAssignee")
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  pushTokens         PushToken[]
  member             Member?
  guardianLinks      GuardianLink[]       @relation("GuardianUser")

  @@index([role])
  @@map("users")
}

/// One private tenant. Formerly "College".
model Organization {
  id         String               @id @default(uuid())
  name       String
  code       String               @unique
  joinCode             String   @unique
  industry             String   @default("EDUCATION")
  organizationTypeId   String?
  address    String?
  state      String?
  district   String?
  contactName String?
  phone      String?
  email      String?
  logoUrl    String?
  /// Branding, feature flags, report categories, and profile-field schema.
  settings   Json                 @default("{}")
  status     OrganizationStatus   @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  auditLogs   AuditLog[]
  staff       OrgStaff[]
  incidents   Incident[]
  members     Member[]
  departments      Department[]
  organizationType OrganizationType? @relation(fields: [organizationTypeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([industry])
  @@index([organizationTypeId])
  @@map("organizations")
}

/// Support-defined vertical. Built-ins are seeded; new client types are created here.
model OrganizationType {
  id                  String         @id @default(uuid())
  slug                String         @unique
  label               String
  blurb               String         @default("")
  isSystem            Boolean        @default(false)
  isActive            Boolean        @default(true)
  features            Json           @default("{}")
  categories          Json           @default("[]")
  defaultDepartments  Json           @default("[]")
  orgSetupFields      Json           @default("[]")
  memberFields        Json           @default("[]")
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organizations       Organization[]

  @@index([isActive])
  @@map("organization_types")
}

/// Everyday person the platform protects. Organization is optional (standalone SOS).
model Member {
  id                    String         @id @default(uuid())
  userId                String         @unique
  organizationId        String?
  name                  String
  photoUrl              String?
  memberNumber          String?
  dateOfBirth           DateTime?
  gender                String?
  department            String?
  course                String?
  semester              String?
  year                  Int?
  section               String?
  isHosteler            Boolean?       @default(false)
  mobile                String?
  guardianName          String?
  guardianPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  permanentAddress      String?
  hostelAddress         String?
  hostelRoomNumber      String?
  bloodGroup            String?
  medicalConditions     String?
  allergies             String?
  disability            String?
  /// Industry-specific fields that are not first-class columns.
  profile               Json           @default("{}")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  incidents             Incident[]
  guardianLinks         GuardianLink[]
  assignedDepartmentId  String?
  assignedDepartment    Department?    @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  organization          Organization?  @relation(fields: [organizationId], references: [id])
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([memberNumber])
  @@index([assignedDepartmentId])
  @@map("members")
}

/// Owner / Admin / Staff membership in one organization.
model OrgStaff {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  orgRole        OrgRole  @default(ADMIN)
  name           String
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments    DepartmentStaff[]

  @@index([organizationId])
  @@index([organizationId, orgRole])
  @@map("org_staff")
}

/// Optional routing unit inside an organization. Members have one; staff may have many.
model Department {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        Member[]
  staff          DepartmentStaff[]
  incidents      Incident[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("departments")
}

model DepartmentStaff {
  departmentId String
  orgStaffId   String
  createdAt    DateTime    @default(now())
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  orgStaff     OrgStaff    @relation(fields: [orgStaffId], references: [id], onDelete: Cascade)

  @@id([departmentId, orgStaffId])
  @@index([orgStaffId])
  @@map("department_staff")
}

/// Privacy-respecting family link. Guardians are alerted only on Emergency SOS.
model GuardianLink {
  id                  String             @id @default(uuid())
  memberId            String
  guardianUserId      String?
  inviteCodeHash      String?            @unique
  inviteCodeExpiresAt DateTime?
  status              GuardianLinkStatus @default(PENDING)
  createdAt           DateTime           @default(now())
  acceptedAt          DateTime?
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian            User?              @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([guardianUserId])
  @@map("guardian_links")
}

/// A filed report / case. Organization is null for standalone SOS.
model Incident {
  id                String            @id @default(uuid())
  code              String            @unique
  organizationId    String?
  memberId          String?
  assignedToUserId  String?
  departmentId      String?
  type              ReportType
  category          String
  status            IncidentStatus    @default(SUBMITTED)
  priority          IncidentPriority  @default(NORMAL)
  description       String
  incidentDate      DateTime?
  location          String?
  suspectedPeople   String?
  witnesses         String?
  gpsLat            Float?
  gpsLng            Float?
  gpsAccuracy       Float?
  deviceInfo        String?
  isAnonymous       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  resolutionReport  String?
  evidence          IncidentEvidence[]
  messages          IncidentMessage[]
  timeline          IncidentTimeline[]
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  member            Member?           @relation(fields: [memberId], references: [id])
  assignedTo        User?             @relation("IncidentAssignee", fields: [assignedToUserId], references: [id])
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, departmentId, status])
  @@index([memberId])
  @@index([assignedToUserId])
  @@index([type, status])
  @@map("incidents")
}

model IncidentEvidence {
  id            String       @id @default(uuid())
  incidentId    String
  type          EvidenceType
  storagePath   String
  fileName      String
  mimeType      String?
  sizeBytes     Int?
  uploadedById  String?
  createdAt     DateTime     @default(now())
  incident      Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@map("incident_evidence")
}

model IncidentMessage {
  id          String    @id @default(uuid())
  incidentId  String
  authorId    String?
  authorRole  UserRole
  body        String
  createdAt   DateTime  @default(now())
  author      User?     @relation(fields: [authorId], references: [id])
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_messages")
}

model IncidentTimeline {
  id          String         @id @default(uuid())
  incidentId  String
  status      IncidentStatus
  note        String?
  actorId     String?
  createdAt   DateTime       @default(now())
  actor       User?          @relation(fields: [actorId], references: [id])
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_timeline")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model AuditLog {
  id             String        @id @default(uuid())
  actorId        String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum UserRole {
  MEMBER
  GUARDIAN
  STAFF
  ADMIN
  OWNER
  SUPPORT
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ReportType {
  EMERGENCY
  NORMAL
  ANONYMOUS
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATING
  MORE_INFO_REQUESTED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum EvidenceType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum NotificationType {
  REPORT_SUBMITTED
  INVESTIGATION_STARTED
  MORE_INFO_REQUESTED
  REPORT_CLOSED
  NEW_EMERGENCY_REPORT
  NEW_COMPLAINT
  NEW_EVIDENCE_UPLOADED
  STATUS_CHANGED
  GENERIC
  NEW_MESSAGE
  GUARDIAN_EMERGENCY
}
