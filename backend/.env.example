# --- Database (Supabase Postgres connection string) -------------------------
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Transaction" pooler connection for the app, and DIRECT_URL (non-pooled) for migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# --- App ----------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Supabase Storage (evidence files) -----------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_EVIDENCE_BUCKET="evidence"

# --- Firebase (push notifications - wired up later) ----------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Seed --------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="superadmin@campussafety.dev"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
