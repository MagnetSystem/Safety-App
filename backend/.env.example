# --- Database ----------------------------------------------------------------
# Local development (default): Postgres on this machine.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/safety_platform?schema=public"
DIRECT_URL="postgresql://postgres@127.0.0.1:5432/safety_platform?schema=public"
#
# Production: set these to the hosted server (Supabase / Railway / etc.).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Optional. Cache, distributed rate limits, and notification queue.
# Local/dev works without it (in-memory fallback).
REDIS_URL="redis://127.0.0.1:6379"

# --- App ----------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# --- Auth -----------------------------------------------------------------
# Generate real values — never ship these placeholders:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Supabase Storage (evidence files) -----------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_EVIDENCE_BUCKET="evidence"

# --- Seed --------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="superadmin@campussafety.dev"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (password reset) -------------------------------------------------
# Leave SMTP_* empty during testing — reset links are printed to the server
# log instead of emailed. Set either SMTP_URL or SMTP_HOST/PORT/USER/PASS.
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Safety Platform <no-reply@campus-safety.app>"

# Where password-reset links point. STUDENT_APP_SCHEME must match app.json.
ADMIN_PORTAL_URL="http://localhost:5173"
STUDENT_APP_SCHEME="studentapp"
